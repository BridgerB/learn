{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!build",
			"!.svelte-kit",
			"!test-results",
			"!data/SKILL.md",
			"!.claude/skills/learn/SKILL.md",
			"!index.html"
		],
		"maxSize": 8388608
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
