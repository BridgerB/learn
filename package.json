{
	"name": "learn",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:html": "node scripts/build-html.ts",
		"build:index": "node scripts/build-html.ts && cp build/learn.html index.html",
		"new": "node scripts/new.ts",
		"setup:voice": "bash scripts/setup-voice.sh",
		"narrate": "\"${LEARN_HOME:-$HOME/.cache/learn}/venv/bin/python\" scripts/narrate.py",
		"check:layout": "node scripts/check-layout.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint && eslint .",
		"format": "biome format --write",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@bridgerb/port-from-name": "^1.0.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"fzstd": "^0.1.1",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Narrated, single-file HTML explainers: the /learn Claude Code skill and its template"
}
