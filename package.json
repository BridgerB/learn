{
	"name": "learn",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --include-main-module=false --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --include-main-module=false --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write",
		"lint": "biome lint",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types --include-main-module=false",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@bridgerb/port-from-name": "^1.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-devtools-svelte": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@vitejs/devtools": "^0.8.3",
		"@vitejs/devtools-oxc": "^0.8.3",
		"@vitejs/devtools-rolldown": "^0.8.3",
		"@vitejs/devtools-vite": "^0.8.3",
		"@vitejs/devtools-vitest": "^0.8.3",
		"@vitest/browser-playwright": "^5.1.0",
		"auth": "^1.7.25",
		"better-auth": "^1.7.25",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"playwright": "^1.65.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.162.0"
	}
}
